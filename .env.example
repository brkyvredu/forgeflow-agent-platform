# Authentication: choose GOOGLE_API_KEY or Google Cloud ADC.
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west4

# Models are configurable so upgrades do not require code changes.
FORGEFLOW_MODEL=gemini-3.6-flash
FORGEFLOW_EMBEDDING_MODEL=gemini-embedding-001
FORGEFLOW_EMBEDDING_DIMENSION=768

MCP_SERVER_URL=http://localhost:8001/mcp
JAVA_ANALYSIS_URL=http://localhost:8080
DATABASE_URL=postgresql://forgeflow:forgeflow@localhost:5432/forgeflow
REPOSITORY_ROOT=/workspace/repository

OTEL_SERVICE_NAME=forgeflow-agent
# Leave blank for local CLI use. Docker Compose and Kubernetes set this explicitly.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true

POSTGRES_DB=forgeflow
POSTGRES_USER=forgeflow
POSTGRES_PASSWORD=forgeflow
